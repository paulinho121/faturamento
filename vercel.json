{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/escala-sync.ts": { "maxDuration": 60 },
    "api/jarvis-sync.ts": { "maxDuration": 60 },
    "api/jarvis.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/jarvis/:rota*", "destination": "/api/jarvis?rota=:rota*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
