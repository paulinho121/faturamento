VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Usadas só pela função serverless api/crm-pedido.ts (nunca pelo app React —
# sem prefixo VITE_ de propósito, pra não ir pro bundle do navegador).
# SUPABASE_SERVICE_ROLE_KEY: Supabase > Project Settings > API > service_role key.
# CRM_WEBHOOK_SECRET: qualquer string secreta longa, definida por você; o CRM
#   precisa mandar ela de volta no header x-webhook-secret.
# CRM_SERVICE_PROFILE_ID: id de um profile "de sistema" criado só pra
#   registrar pedidos vindos do CRM como created_by (veja o comentário no
#   topo de api/crm-pedido.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRM_WEBHOOK_SECRET=uma-string-secreta-bem-longa
CRM_SERVICE_PROFILE_ID=00000000-0000-0000-0000-000000000000
