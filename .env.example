VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Usadas só pela função serverless api/crm-pedido.ts (nunca pelo app React —
# sem prefixo VITE_ de propósito, pra não ir pro bundle do navegador).
# SUPABASE_SERVICE_ROLE_KEY: Supabase > Project Settings > API > service_role key.
# CRM_WEBHOOK_SECRET: qualquer string secreta longa, definida por você; o CRM
#   precisa mandar ela de volta no header x-webhook-secret.
# CRM_SERVICE_PROFILE_ID: id de um profile "de sistema" criado só pra
#   registrar dados vindos de integrações automáticas (CRM, watcher de XML de
#   NF-e) como created_by — mesmo profile serve pras duas (veja o comentário
#   no topo de api/crm-pedido.ts e api/nfe-watcher.ts).
# NFE_WATCHER_SECRET: string secreta separada da do CRM (assim dá pra
#   revogar uma sem mexer na outra); o script watch-nfe.js do faturista manda
#   ela de volta no header x-watcher-secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRM_WEBHOOK_SECRET=uma-string-secreta-bem-longa
CRM_SERVICE_PROFILE_ID=00000000-0000-0000-0000-000000000000
NFE_WATCHER_SECRET=outra-string-secreta-bem-longa

# Andamento automático dos pedidos de Santa Catarina (api/escala-sync.ts).
# ESCALA_USUARIO / ESCALA_SENHA: login da API do CD (Escalasoft) — os mesmos
#   já usados nas integrações com o CD de SC. Só na Vercel, nunca no código.
# ESCALA_CNPJ: CNPJ do CD enviado nas consultas (mesmo valor das outras integrações).
# ESCALA_API_URL: opcional; padrão https://api.escalasoft.com.br
# ESCALA_SYNC_SECRET: string secreta longa; o agendador manda ela no header
#   x-sync-secret (GET /api/escala-sync a cada ~5 min).
ESCALA_USUARIO=usuario-da-api-do-cd
ESCALA_SENHA=senha-da-api-do-cd
ESCALA_CNPJ=00000000000000
ESCALA_SYNC_SECRET=mais-uma-string-secreta-bem-longa
